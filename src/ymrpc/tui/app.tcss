/* app.tcss */
Screen {
    align: center middle;
}

#outer-frame {
    width: 95%;
    max-width: 120;
    height: auto;
    max-height: 110;
    border: heavy #7289da;
    padding: 1;
}

#main {
    width: 100%;
    height: auto;
    max-height: 110;
}

.section {
    width: 100%;
    height: auto;
    border: heavy #45475a;
    padding: 1 3;
    margin-bottom: 1;
}

#header-section {
    border: heavy #7289da;
}

#header-row {
    height: auto;
    width: 100%;
}

#heading {
    width: 1fr;
    max-width: 70%;
    color: #7289da;
    text-style: bold;
    text-align: left;
}

#daemon-status {
    width: 1fr;
    color: #a6e3a1;
    text-align: right;
}

.section-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

#now-playing {
    color: #cdd6f4;
    padding: 1 0;
}

#config-desc {
    color: #a6adc8;
    padding: 1 0;
}



Footer {
    background: #1e1e2e;     
    color: #a6adc8;          
}

Footer > .footer--key {
    background: #7289da;     
    color: #ffffff;            
    text-style: bold;
}

Footer > .footer--highlight {
    background: #313244;       
}



Header {
    background: #1e1e2e;
    color: #a6adc8;
    height: 1;                  
}

Header {
    background: #1e1e2e;          
    color: #a6adc8;              
}


Header .header--title {
    text-style: bold;
    color: #7289da;             
}
