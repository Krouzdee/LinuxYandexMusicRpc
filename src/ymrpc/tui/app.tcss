/* app.tcss */
Screen {
    align: center middle;
}

#outer-frame {
    width: 95%;
    max-width: 120;
    height: auto;
    max-height: 110;
    border: heavy #7289da;
    padding: 1;
}

#main {
    width: 100%;
    height: auto;
    max-height: 110;
}

.section {
    width: 100%;
    height: auto;
    border: heavy #45475a;
    padding: 1 3;
    margin-bottom: 1;
}

#header-section {
    border: heavy #7289da;
}

#header-row {
    height: auto;
    width: 100%;
}

#heading {
    width: 1fr;
    max-width: 70%;
    color: #7289da;
    text-style: bold;
    text-align: left;
}

#daemon-status {
    width: 1fr;
    color: #a6e3a1;
    text-align: right;
}

.section-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

#now-playing {
    color: #cdd6f4;
    padding: 1 0;
}

#config-desc {
    color: #a6adc8;
    padding: 1 0;
}

/* Настройки Header & Footer */
Header {
    background: #1e1e2e;
    color: #a6adc8;
    height: 1;                  
}

Header .header--title {
    text-style: bold;
    color: #7289da;             
}

Footer {
    background: #1e1e2e;     
    color: #a6adc8;          
}

Footer > .footer--key {
    background: #7289da;     
    color: #ffffff;            
    text-style: bold;
}

Footer > .footer--highlight {
    background: #313244;       
}

/* Компоненты экрана конфигурации */
.config-card {
    width: 100%;
    height: auto;
    border: heavy #45475a;
    background: transparent;
    margin-bottom: 1;
    padding: 1 3;
}

.config-card:hover {
    background: #313244; 
    border: heavy #7289da; 
}

.config-card .section-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 1;
}

.config-card #config-desc {
    color: #a6adc8;
    padding: 1 0;
}

#config-container {
    width: 95%;
    max-width: 120;
    height: auto;
    border: heavy #7289da;
    padding: 2 4;
    background: #1e1e2e; 
}

#btn-back {
    margin-top: 2;
    width: 40;
    align: center middle;
}



/* Setup / Authorization Screen */

#setup-container {
    width: 95%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    border: heavy #7289da;
    padding: 2 3;
    background: #1e1e2e;
}

#setup-container .section-title {
    color: #cba6f7;
    text-style: bold;
    margin-bottom: 2;
}

#setup-status {
    color: #a6adc8;
    padding: 1 0;
    margin-bottom: 1;
}

#setup-link {
    width: 100%;
    color: #89b4fa;
    text-style: underline;
    padding: 1;
    border: round #45475a;
    margin-bottom: 1;
}

#setup-code {
    width: 100%;
    color: #a6e3a1;
    background: #313244;
    border: round #45475a;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
    text-style: bold;
}

#setup-container Button {
    width: 100%;
    margin-top: 1;
}

#btn-auth {
    background: #7289da;
    color: #ffffff;
    text-style: bold;
    border: heavy #7289da;
}

#btn-auth:hover {
    background: #8caaee;
    border: heavy #b4befe;
}

#btn-auth:focus {
    border: heavy #cba6f7;
}

#setup-container #btn-back {
    background: #313244;
    color: #cdd6f4;
    border: heavy #45475a;
}

#setup-container #btn-back:hover {
    background: #45475a;
    border: heavy #7289da;
}

#setup-description {
    color: #a6adc8;
    margin-bottom: 1;
}

#setup-success {
    color: #a6e3a1;
    text-style: bold;
    padding: 2 0;
    text-align: center;
}